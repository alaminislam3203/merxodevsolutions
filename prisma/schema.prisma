// Prisma Schema - MerxoDevSolutions Admin
// Prisma 7: connection URL moved to prisma.config.ts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id               String   @id @default(cuid())
  email            String   @unique
  password         String
  name             String   @default("Admin")
  image            String?
  twoFactorEnabled Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model User {
  id               String   @id @default(cuid())
  name             String
  email            String   @unique
  password         String
  image            String?
  role             String   @default("USER")
  twoFactorEnabled Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  reviews          Review[]
}

model Review {
  id         String   @id @default(cuid())
  userName   String
  userRole   String?  @default("Client")
  userImage  String?
  userEmail  String?
  company    String?
  location   String?
  tag        String?  @default("Verified Client")
  rating     Int      @default(5)
  comment    String   @db.Text
  isApproved Boolean  @default(false)
  isFeatured Boolean  @default(false)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  tag         String
  title       String
  description String   @db.Text
  image       String?
  images      Json
  liveUrl     String?
  accent      String
  details     Json
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContentBlock {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String
  value     String   @db.Text
  section   String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MediaFile {
  id         String   @id @default(cuid())
  url        String
  publicId   String
  altText    String   @default("")
  caption    String   @default("")
  fileSize   Int?
  width      Int?
  height     Int?
  uploadedAt DateTime @default(now())
}

model Banner {
  id         String   @id @default(cuid())
  imageUrl   String
  title      String?
  subtitle   String?
  buttonText String?
  buttonLink String?
  isActive   Boolean  @default(true)
  slot       String   @default("left")
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TeamMember {
  id          String   @id @default(cuid())
  name        String
  role        String
  image       String?
  bio         String?  @db.Text
  color       String?  @default("from-violet-600 to-cyan-500")
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  socialLinks Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model TwoFactorToken {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model DailyVisitor {
  id           String   @id @default(cuid())
  date         String   @unique // "YYYY-MM-DD" e.g. "2026-09-17"
  uniqueVisits Int      @default(0)
  pageViews    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([date])
}

model VisitorLog {
  id          String   @id @default(cuid())
  visitorHash String
  ip          String?
  path        String   @default("/")
  userAgent   String?
  device      String?
  browser     String?
  country     String?
  referrer    String?
  date        String   // "YYYY-MM-DD"
  createdAt   DateTime @default(now())

  @@index([date])
  @@index([visitorHash])
  @@index([createdAt])
}

model EnvVault {
  id          String   @id @default(cuid())
  projectName String
  environment String   @default("production") // production, development, staging, test
  fileName    String   @default(".env")
  content     String   @db.Text
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectName])
  @@index([environment])
}

model ChatSession {
  id            String        @id
  visitorName   String        @default("Visitor")
  visitorEmail  String?
  visitorPhone  String?
  visitorImage  String?
  visitorIp     String?
  language      String        @default("en")
  mode          String        @default("ai") // "ai" | "live"
  needsHuman    Boolean       @default(false)
  unreadAdmin   Int           @default(0)
  unreadVisitor Int           @default(0)
  lastMessage   String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  messages      ChatMessage[]

  @@index([updatedAt])
  @@index([needsHuman])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender    String      // "user" | "bot" | "admin" | "system"
  text      String      @db.Text
  actions   Json?
  createdAt DateTime    @default(now())

  @@index([sessionId])
  @@index([createdAt])
}