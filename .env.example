# =============================================================
# MerxoDev Solutions — Environment Variables Template
# Copy this file to .env.local and fill in the values.
# =============================================================

# --- Resend Email (Recommended for 100% Inbox Delivery) ---
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY="re_123456789_your_resend_api_key"
RESEND_FROM_EMAIL="MerxoDev Solutions <merxodevsolutions@gmail.com>" # or "onboarding@resend.dev"

# --- Nodemailer / Fallback Gmail SMTP ---
GMAIL_USER="merxodevsolutions@gmail.com"
GMAIL_PASS="your-gmail-app-password"

# --- App URL & Meeting Links ---
NEXT_PUBLIC_SITE_URL="https://merxodevsolutions.pro.bd"
NEXT_PUBLIC_API_URL="https://merxodevsolutions.pro.bd"
PORT=3000
NEXT_PUBLIC_GOOGLE_MEET_LINK="https://meet.google.com/new" # Replace with your persistent Google Meet link or leave as default

# --- PostgreSQL (Neon.tech / Supabase / Local PG) ---
DATABASE_URL="postgresql://username:password@ep-example.neon.tech/neondb?sslmode=require"

# --- NextAuth Configuration ---
# Generate secret using: `openssl rand -hex 32`
NEXTAUTH_SECRET="your-nextauth-secret-key-32-chars-long"
NEXTAUTH_URL="https://merxodevsolutions.pro.bd"

# --- Cloudinary (Image & Banner Uploads) ---
# Get from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# --- Admin Seeding ---
# Used for POST /api/admin/seed
SEED_SECRET_KEY="your-random-seed-secret-key"
ADMIN_EMAIL="admin@merxodevsolutions.pro.bd"
ADMIN_PASSWORD="YourSecureAdminPassword123!"
ADMIN_NAME="MerxoDev Admin"
